{
  "info": {
    "name": "MisterMath",
    "description": "MisterMath API.\n\n1. Run **Auth / Login** first: it stores the JWT in the `token` collection variable, and every other request sends it as `Authorization: Bearer {{token}}`.\n2. Each successful calculation stores its id in `transactionId`, used by **Transactions / Transaction by id**.\n\nRun the whole collection with the Collection Runner or `newman run`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns a Bearer token', () => pm.expect(json.data.tokenType).to.eql('Bearer'));",
                  "pm.collectionVariables.set('token', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - wrong password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Explains the error', () => pm.expect(pm.response.json().data.message).to.eql('Invalid username or password'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Calculations (Command)",
      "item": [
        {
          "name": "SINGLETON  10 + 5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Wrapper code is 201', () => pm.expect(json.code).to.eql(201));",
                  "pm.test('Engine is SingletonCalculationEngine', () => pm.expect(json.data.engine).to.eql('SingletonCalculationEngine'));",
                  "pm.test('Result is 15', () => pm.expect(Number(json.data.result)).to.eql(15));",
                  "pm.test('Trace explains the flow', () => pm.expect(json.data.trace).to.be.an('array').that.is.not.empty);",
                  "pm.collectionVariables.set('transactionId', json.data.transactionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"num1\": 10,\n  \"num2\": 5,\n  \"operation\": \"+\",\n  \"pattern\": \"SINGLETON\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/calculations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calculations"
              ]
            }
          }
        },
